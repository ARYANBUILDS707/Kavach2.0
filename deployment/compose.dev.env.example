# Template for deployment/compose.dev.yml. Copy to deployment/.env.dev (ignored by Git)
# and replace every value with a random hex string, for example: openssl rand -hex 24
# Hex keeps the values safe inside connection URLs and the Redis config line.
KAVACH_DEV_POSTGRES_PASSWORD=replace-with-random-hex
KAVACH_DEV_MIGRATOR_PASSWORD=replace-with-random-hex
KAVACH_DEV_APP_PASSWORD=replace-with-random-hex
KAVACH_DEV_RETENTION_PASSWORD=replace-with-random-hex
KAVACH_DEV_REDIS_PASSWORD=replace-with-random-hex

# Host ports, bound to 127.0.0.1 only.
KAVACH_DEV_POSTGRES_PORT=55432
KAVACH_DEV_REDIS_PORT=56379
