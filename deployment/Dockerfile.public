# Build from repository root. No model downloads or private files enter the build context.
FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.11.16@sha256:440fd6477af86a2f1b38080c539f1672cd22acb1b1a47e321dba5158ab08864d AS uv
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS python-env
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock /app/backend/
COPY backend/src /app/backend/src
RUN uv sync --project backend --locked --no-dev --no-editable
COPY workers/sms/pyproject.toml workers/sms/uv.lock /app/workers/sms/
COPY workers/sms/src /app/workers/sms/src
RUN uv sync --project workers/sms --locked --no-dev --group model --no-editable
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS runtime
WORKDIR /app
ENV PYTHONUNBUFFERED=1
COPY --from=python-env /app/backend/.venv /app/backend/.venv
COPY --from=python-env /app/workers/sms/.venv /app/workers/sms/.venv
COPY deployment/models /app/deployment/models
COPY --from=frontend /build/frontend/dist /app/public
RUN groupadd --gid 10001 kavach && useradd --uid 10001 --gid kavach --no-create-home kavach
USER 10001:10001
ENV APP_ENV=pilot PUBLIC_ANALYZER_ONLY=true PUBLIC_ANALYZER_MODE=disabled \
    SMS_WORKER_ENABLED=false PUBLIC_FRONTEND_DIR=/app/public \
    SMS_WORKER_PYTHON=/app/workers/sms/.venv/bin/python \
    MODEL_MANIFEST_PATH=/app/deployment/models/sms_classifier.horizon.v1.json \
    MODEL_DIR=/models SMS_WORKER_LOCK_PATH=/tmp/kavach-public-worker.lock
EXPOSE 8080
# Exactly one API process. Ignore forwarding headers until a trusted edge is verified.
# Disable access logs: URLs and edge IPs must not become an accidental content archive.
CMD ["sh", "-c", "exec /app/backend/.venv/bin/uvicorn kavach.main:create_app --factory --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --limit-concurrency 32 --timeout-keep-alive 5 --no-access-log --no-proxy-headers"]
