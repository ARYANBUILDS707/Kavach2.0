# Isolated public service. These defaults DO NOT authorize or enable hosted inference.
APP_ENV=pilot
PUBLIC_ANALYZER_ONLY=true
PUBLIC_ANALYZER_MODE=disabled
SMS_WORKER_ENABLED=false
# APP_ORIGIN=https://your-approved-domain.example
# REDIS_URL=redis://:REPLACE_WITH_SECRET@private-redis:6379/0
# RATE_LIMIT_HMAC_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PUBLIC_ANALYZER_MAX_CHARS=500
PUBLIC_ANALYZER_IP_LIMIT_PER_MINUTE=5
PUBLIC_ANALYZER_GLOBAL_LIMIT_PER_MINUTE=60
MAX_INFLIGHT_ANALYSES=2
SMS_INFERENCE_TIMEOUT_MS=2000
INFERENCE_TIMEOUT_SECONDS=30
# Do not set DATABASE_URL, audit, subscriber, payload or admin keys on this service.
# C-13 local fictional tests only: use development, a loopback APP_ORIGIN,
# PUBLIC_ANALYZER_MODE=local-experimental, SMS_WORKER_ENABLED=true,
# SMS_MODEL_AUTHORIZATION=experimental-local-unvalidated and the verified absolute model paths.
# Hosted mode refuses startup even with PUBLIC_ANALYZER_HOSTED_APPROVAL.
