# Copy to .env in the project root; never commit real environment files.
APP_ENV=development
LOG_LEVEL=INFO

# Database and Redis are validated at startup when set. Authentication (below) needs both.
# Use the least-privilege runtime role, never the migration owner or the superuser.
# Local values come from deployment/compose.dev.yml (see README "Development services").
# DATABASE_URL=postgresql+psycopg://kavach_app:<runtime-password>@127.0.0.1:55432/kavach_dev
# REDIS_URL=redis://:<redis-password>@127.0.0.1:56379/0

# Migrations only (alembic -c backend/alembic.ini ...): the migration-owner role, not the runtime role.
# MIGRATION_DATABASE_URL=postgresql+psycopg://kavach_migrator:<migrator-password>@127.0.0.1:55432/kavach_dev

# Authentication (M2.3). All-or-nothing: set every value below plus DATABASE_URL and REDIS_URL,
# or none (the auth routes then answer 503). APP_ENV=pilot requires all of them.
# APP_ORIGIN is exactly what browsers send in Origin: https://host[:port], no trailing slash.
# Plain http is accepted only with APP_ENV=development and a localhost/loopback host.
# Generate secrets with: openssl rand -hex 32
# APP_ORIGIN=http://localhost:8000
# RATE_LIMIT_HMAC_KEY=<32+ character random secret>
# AUDIT_HMAC_KEYS={"v1": "<32+ character random secret>"}
# AUDIT_HMAC_ACTIVE_VERSION=v1
# Defaults (approved D03/D07): SESSION_IDLE_MINUTES=30, SESSION_MAX_HOURS=8, AUDIT_RETENTION_DAYS=30

# Future variable contracts are documented in docs/API.md.
