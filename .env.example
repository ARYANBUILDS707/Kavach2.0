# Copy to .env in the project root; never commit real environment files.
APP_ENV=development
LOG_LEVEL=INFO

# Database and Redis are validated at startup when set. Authentication (below) needs both.
# Use the least-privilege runtime role, never the migration owner or the superuser.
# Local values come from deployment/compose.dev.yml (see README "Development services").
# DATABASE_URL=postgresql+psycopg://kavach_app:<runtime-password>@127.0.0.1:55432/kavach_dev
# REDIS_URL=redis://:<redis-password>@127.0.0.1:56379/0

# Migrations only (alembic -c backend/alembic.ini ...): the migration-owner role, not the runtime role.
# MIGRATION_DATABASE_URL=postgresql+psycopg://kavach_migrator:<migrator-password>@127.0.0.1:55432/kavach_dev

# Operator retention runs only (python -m kavach.cli retention run): the kavach_retention role.
# RETENTION_DATABASE_URL=postgresql+psycopg://kavach_retention:<retention-password>@127.0.0.1:55432/kavach_test

# Authentication (M2.3). All-or-nothing: set every value below plus DATABASE_URL and REDIS_URL,
# or none (the auth routes then answer 503). APP_ENV=pilot requires all of them.
# APP_ORIGIN is exactly what browsers send in Origin: https://host[:port], no trailing slash.
# Plain http is accepted only with APP_ENV=development and a localhost/loopback host.
# Generate secrets with: openssl rand -hex 32
# APP_ORIGIN=http://localhost:8000
# RATE_LIMIT_HMAC_KEY=<32+ character random secret>
# AUDIT_HMAC_KEYS={"v1": "<32+ character random secret>"}
# AUDIT_HMAC_ACTIVE_VERSION=v1
# Defaults (approved D03/D07): SESSION_IDLE_MINUTES=30, SESSION_MAX_HOURS=8, AUDIT_RETENTION_DAYS=30

# Event ingestion (M3.1). All-or-nothing; requires the authentication settings above.
# Retired versions must stay listed so stored digests can still be compared.
# SUBSCRIBER_HMAC_KEYS={"v1": "<32+ character random secret>"}
# SUBSCRIBER_HMAC_ACTIVE_VERSION=v1
# PAYLOAD_HMAC_KEYS={"v1": "<32+ character random secret>"}
# PAYLOAD_HMAC_ACTIVE_VERSION=v1
# Default (approved D07): EVENT_RETENTION_DAYS=7
# Total ingestion deadline in seconds (D08): INFERENCE_TIMEOUT_SECONDS=30

# Pretrained SMS worker (M4-I.2). Off by default. When enabled, every value below is required,
# paths must be absolute, and the event ingestion settings above must be present. The worker runs
# from its own environment (workers/sms, `uv sync --project workers/sms --locked --group model`),
# offline, on CPU. No model files or secrets live in Git.
# SMS_WORKER_ENABLED=true
# Required whenever the worker is enabled: no M4-Q GO verdict exists, so the only accepted value
# is the owner-authorized local experiment (docs/EXPERIMENTAL_SMS_ANALYSIS.md). It is refused
# unless APP_ENV=development and APP_ORIGIN is a loopback origin; never set it for a pilot.
# SMS_MODEL_AUTHORIZATION=experimental-local-unvalidated
# SMS_WORKER_PYTHON=/absolute/path/to/Kavach2.0/workers/sms/.venv/bin/python
# MODEL_DIR=/absolute/path/to/Kavach2.0/data/models
# MODEL_MANIFEST_PATH=/absolute/path/to/Kavach2.0/deployment/models/sms_classifier.horizon.v1.json
# Defaults: MAX_INFLIGHT_ANALYSES=2, SMS_INFERENCE_TIMEOUT_MS=2000, SMS_WORKER_THREADS=2,
# SMS_WORKER_MAX_RSS_MB=1536, SMS_WORKER_START_TIMEOUT_SECONDS=90, INFERENCE_DEVICE=cpu

# Future variable contracts are documented in docs/API.md.
