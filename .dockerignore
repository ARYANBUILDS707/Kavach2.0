# Allow only build inputs; private local files never enter Docker's context.
**
!frontend/
!frontend/**
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/src/
!backend/src/**
!workers/
!workers/sms/
!workers/sms/pyproject.toml
!workers/sms/uv.lock
!workers/sms/src/
!workers/sms/src/**
!deployment/
!deployment/models/
!deployment/models/*.json
**/.git
**/.env
**/.env.*
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/dist
**/test-results
**/playwright-report
**/.DS_Store
